{
  "name": "@japanglobal/kit",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vanilla-cookieconsent": "3.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.0",
    "next": "15.5.6",
    "posthog-js": "1.450.1",
    "posthog-node": "6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "description": "Shared code for Japan Global Council websites: cookie consent, consent-gated tracking chain, legal pages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japanglobal/kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./consent": {
      "types": "./dist/consent/index.d.ts",
      "default": "./dist/consent/index.js"
    },
    "./consent/react": {
      "types": "./dist/consent/react.d.ts",
      "default": "./dist/consent/react.js"
    },
    "./consent/server": {
      "types": "./dist/consent/server.d.ts",
      "default": "./dist/consent/server.js"
    },
    "./track": {
      "types": "./dist/track/index.d.ts",
      "default": "./dist/track/index.js"
    },
    "./legal": {
      "types": "./dist/legal/react.d.ts",
      "default": "./dist/legal/react.js"
    },
    "./consent.css": "./dist/consent.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.test.json --noUnusedLocals --noUnusedParameters",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "posthog-js": ">=1.200",
    "posthog-node": ">=5"
  },
  "peerDependenciesMeta": {
    "posthog-js": {
      "optional": true
    },
    "posthog-node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
